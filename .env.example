# Copiar a .env (no se versiona). Valores solo para desarrollo local.
DATABASE_URL=postgresql://guard:guard@127.0.0.1:5432/mcp_guard
GUARD_HOST=127.0.0.1
GUARD_PORT=3000
UPSTREAM_URL=http://127.0.0.1:3001/mcp
UPSTREAM_PORT=3001
POLICY_FILE=config/policy.example.yaml
# Guard rechaza arrancar con "change-me" o secretos de menos de 16 caracteres.
# Genere cada uno con: openssl rand -hex 32
MCP_GUARD_TOKEN=change-me
# Secreto compartido solo entre Guard y la tienda demo.
UPSTREAM_TOKEN=change-me
# Secreto para iniciar sesion en el panel. El agente no debe conocerlo.
DASHBOARD_ADMIN_SECRET=change-me
# Origenes exactos permitidos para el panel (5173 solo para el servidor de desarrollo de Vite).
PANEL_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173
DEMO_MODE=true
